{
    "name": "tyhpdef/vimeo-psalm-impl",
    "description": "Implementation package for tyhpdef/vimeo-psalm. Require tyhpdef/vimeo-psalm, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.0.0.0-beta19",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/php-ext-simplexml": "@dev",
                "tyhpdef/felixfbecker-language-server-protocol": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/vimeo-psalm"
        }
    },
    "require": {
        "php": ">=8.2",
        "vimeo/psalm": "7.0.0-beta19"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/php-ext-simplexml": "@dev",
        "tyhpdef/felixfbecker-language-server-protocol": "@dev"
    }
}
